# Turso (libSQL) database — create a free database at turso.tech.
# Leave both unset locally to fall back to a local file database (./local.db).
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Long random string used to sign login session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional social sign-in buttons ("Continue with Google" / "Continue with
# Facebook") on the login and register pages. A button is shown ONLY when
# the matching value below is set; leave both unset to hide the buttons
# entirely. (The OAuth sign-in flows themselves are not wired up yet —
# setting an ID shows the button, which leads to a short notice page.)
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=

# Transactional email (verification + password reset) via Resend.
# Create a free account at resend.com and paste the API key here.
# EMAIL_FROM is the sender, e.g. "Tienda <noreply@yourdomain.com>"; leave it
# unset to use Resend's onboarding sender (delivers only to the Resend
# account owner's inbox until a domain is verified in Resend).
# While RESEND_API_KEY is unset, verification and password-reset links are
# shown ON SCREEN instead (setup mode) so the flows still work end-to-end.
# RESEND_API_KEY=
# EMAIL_FROM=

# Public base URL of this deployment, used to build the links inside
# verification / reset emails (e.g. https://tienda-one-xi.vercel.app).
# On Vercel this can stay unset — VERCEL_URL is used as a fallback.
# APP_URL=
