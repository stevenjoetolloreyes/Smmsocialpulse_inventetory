# Turso (libSQL) database — create a free database at turso.tech.
# Leave both unset locally to fall back to a local file database (./local.db).
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Long random string used to sign login session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Social sign-in ("Continue with Google" / "Continue with Facebook") is
# configured by the platform operator in the app itself: Admin → Social
# Login (stored in the database, effective immediately). The buttons are
# always visible; until credentials are saved there, clicking one returns
# a "not set up yet" notice. The variables below are only a fallback for
# values not set in the console. APP_URL (below) is the base the OAuth
# redirect URIs are built from — the same URIs are shown in Admin →
# Social Login for pasting into the Google / Facebook dashboards.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Transactional email (verification + password reset). Two routes:
#
# Route 1 — SMTP (recommended): set SMTP_USER + SMTP_PASS. For Gmail,
# SMTP_USER is the Gmail address and SMTP_PASS is a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords);
# SMTP_HOST/SMTP_PORT default to smtp.gmail.com:465. Any other SMTP
# mailbox works too (e.g. a mailbox on your own domain) — set SMTP_HOST
# and SMTP_PORT to that provider's values. SMTP_FROM overrides the
# sender, e.g. "Tienda <noreply@yourdomain.com>".
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_FROM=
#
# Route 2 — Resend API: create a free account at resend.com and paste
# the API key here. EMAIL_FROM is the sender; leave it unset to use
# Resend's onboarding sender (delivers only to the Resend account
# owner's inbox until a domain is verified in Resend).
# RESEND_API_KEY=
# EMAIL_FROM=
#
# While neither route is configured, verification and password-reset
# links are shown ON SCREEN instead (setup mode) so the flows still
# work end-to-end.

# Public base URL of this deployment, used to build the links inside
# verification / reset emails (e.g. https://tienda-one-xi.vercel.app).
# On Vercel this can stay unset — VERCEL_URL is used as a fallback.
# APP_URL=
